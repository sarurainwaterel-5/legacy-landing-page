# Database (Neon Postgres). DIRECT_URL is the non-pooled URL used for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth
NEXTAUTH_URL=https://legacypartners.agency
NEXTAUTH_SECRET=            # openssl rand -base64 32
GOOGLE_CLIENT_ID=           # optional: enables "Continue with Google"
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=               # comma-separated staff emails that get /admin

# Email (Gmail SMTP with an app password, or another SMTP host)
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=               # where new leads / client activity alerts go
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Private document storage (Vercel Blob, private store)
BLOB_READ_WRITE_TOKEN=

# Public business details
NEXT_PUBLIC_SITE_URL=https://legacypartners.agency
NEXT_PUBLIC_GA_ID=G-E47ET6JEZG
NEXT_PUBLIC_TDI_LICENSE=          # optional override; default 3140432
NEXT_PUBLIC_CSO_REGISTRATION=
# Credit repair is hidden everywhere until this is "true". Turn it on only after the CSO registration and bond are in place.
NEXT_PUBLIC_CREDIT_REPAIR_OPEN=
NEXT_PUBLIC_BUSINESS_ADDRESS=     # optional override; default 302 Talty Rd, Terrell, TX 75160
NEXT_PUBLIC_CONTACT_EMAIL=
