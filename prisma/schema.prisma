generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (next-auth v4 Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime    @default(now())
  accounts      Account[]
  sessions      Session[]
  cases         Case[]
  documents     Document[]  @relation("DocumentOwner")
  agreements    Agreement[]
  messages      Message[]   @relation("MessageClient")
}

// ---------- Leads from the public site ----------

model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  fullName    String
  email       String
  phone       String
  interest    String
  ageRange    String?
  source      String   @default("website")
  page        String?
  consentText String   @db.Text
  status      String   @default("new") // new | contacted | booked | won | lost
  notes       String?  @db.Text
  emailedAt   DateTime?

  @@index([createdAt])
}

// ---------- Client services ----------

model Case {
  id          String         @id @default(cuid())
  userId      String
  service     String         // tax_prep | credit_repair | life_insurance
  status      String         @default("open") // open | waiting_on_client | in_progress | completed | cancelled
  title       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  updates     CaseUpdate[]
  disputes    DisputeItem[]
  documents   Document[]
  agreements  Agreement[]

  @@index([userId])
}

model CaseUpdate {
  id        String   @id @default(cuid())
  caseId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model DisputeItem {
  id         String   @id @default(cuid())
  caseId     String
  bureau     String   // equifax | experian | transunion
  creditor   String
  accountEnd String?  // last 4 only
  reason     String
  round      Int      @default(1)
  status     String   @default("pending") // pending | disputed | removed | updated | verified
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Document {
  id          String    @id @default(cuid())
  userId      String
  caseId      String?
  pathname    String    @unique
  name        String
  size        Int
  contentType String
  category    String    @default("other")
  uploadedBy  String    // user id of the uploader (client or staff)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  user        User      @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  case        Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Agreement {
  id           String    @id @default(cuid())
  userId       String
  caseId       String?
  kind         String    // credit_repair | tax_prep
  version      String
  body         String    @db.Text // exact text the client saw and signed
  bodyHash     String    // sha256 of body
  fee          String?   // total fee and payment terms, entered by staff (CROA requires it in the contract)
  disclosureAckAt DateTime? // client confirmed reading the separate rights disclosure (credit repair)
  esignConsentAt  DateTime? // E-SIGN Act consent to electronic records
  status       String    @default("sent") // sent | signed | cancelled
  signedName   String?
  signedAt     DateTime?
  signedIp     String?
  signedAgent  String?
  cancelBy     DateTime? // end of the 3-business-day window (credit repair)
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case         Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  clientId  String    // the thread is per client
  fromStaff Boolean
  senderId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?
  client    User      @relation("MessageClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// Who viewed/changed sensitive records (FTC Safeguards Rule / IRS Pub 4557 expect this).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
